[include]
	path = ~/.gitconfig-contexts

[user]
	useConfigOnly = true
	name = Ozin
	email = Ozin@users.noreply.github.com

[pull]
	rebase = true

[core]
	pager = diff-so-fancy | less --tabs=4 -+$LESS -RF
	autocrlf = false
	fileMode = false
	hooksPath = ~/.git-hooks
	excludesFile = ~/.gitignore

[interactive]
	diffFilter = diff-so-fancy --patch

[color]
	ui = true

[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22

[color "diff"]
	meta = 11
	frag = magenta bold
	func = 146 bold
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse

[rerere]
	enabled = true

[column]
	ui = auto

[init]
	defaultBranch = main
